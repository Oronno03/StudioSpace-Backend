# StudioSpace Backend — copy this file to .env and fill in your own values

# Port the Express server listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local mongod)
# e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/studiospace?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/studiospace

# Secret used to sign JWT access tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Comma separated list of allowed browser origins (frontend dev server)
CLIENT_ORIGIN=http://localhost:3000

# Google OAuth Web client ID (from Google Cloud Console) — used to verify Google logins
GOOGLE_CLIENT_ID=
